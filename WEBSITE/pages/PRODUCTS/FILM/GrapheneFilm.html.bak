    <!-- GEO: FAQ Schema -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {
                "@type": "Question",
                "name": "What is XIHE's minimum order quantity for graphene heating modules?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Typically 1,000 units for standard orders. Sampling available at 10-50 units for evaluation."
                }
            },
            {
                "@type": "Question",
                "name": "What is the lead time for XIHE graphene film orders?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Standard modules: 7-15 days. Custom modules requiring new tooling: 25-35 days."
                }
            },
            {
                "@type": "Question",
                "name": "Can I get graphene film samples for testing?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Yes. Samples are provided with full test reports based on your application scenario. Sample costs are deducted from your first volume order."
                }
            },
            {
                "@type": "Question",
                "name": "What is the emissivity of XIHE graphene film?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "XIHE graphene film achieves a Normal Spectral Emissivity of ≥0.88, with NIQS-tested 0.88 (NIQS report (2022)WT-HW-00529). This is NIQS-certified and verified by IKKEM FT-IR spectroscopy analysis."
                }
            },
            {
                "@type": "Question",
                "name": "Do you have export certifications?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Modules can be CE, ROHS certified per target market requirements. XIHE provides full technical documentation support."
                }
            },
            {
                "@type": "Question",
                "name": "How do you ensure batch consistency?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Automated printing line + in-line inspection + manual sampling + third-party periodic testing. Every batch is archived for traceability."
                }
            },
            {
                "@type": "Question",
                "name": "Can XIHE supply custom graphene far-infrared films for OEM integration?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Yes. We provide standard and custom graphene heating modules for B2B product integration. Minimum order quantities and technical specifications are available upon request. Our graphene OEM heating solutions have been deployed in partner products across medical and wellness industries."
                }
            }
        ]
    }
    </script>

