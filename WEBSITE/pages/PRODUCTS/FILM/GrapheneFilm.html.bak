    <style>
        :root {
            --bg-white: #FAF8F5;
            --bg-dark: #1A1D24;
            --text-primary: #1A1D24;
            --text-secondary: #475569;
            --text-muted: #888888;
            --accent-gold: #C5A059;
            --border-color: #E5E5E7;
            --series-film: #2D5A3D;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        img { max-width: 100%; height: auto; }

        body {
            font-family: 'Inter', -apple-system, sans-serif;
            background-color: var(--bg-white);
            color: var(--text-primary);
            line-height: 1.7;
            letter-spacing: 0.5px;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        nav {
            position: fixed; top: 0; left: 0; right: 0; height: 70px;
            background: #1A3348;
            display: flex; align-items: center;
            justify-content: space-between;
            padding: 0 10%; z-index: 1000;
        }
        .logo {
            font-family: 'Urbanist', sans-serif;
            font-size: 28px; font-weight: 300;
            letter-spacing: 0.15em;
            color: var(--text-primary);
            text-decoration: none;
        }
        .logo span { color: var(--accent-gold); }
        .nav-links { display: flex; gap: 40px; }
        .nav-links a {
            font-size: 11px; color: #E0E6ED;
            text-decoration: none; letter-spacing: 1px;
            text-transform: uppercase; transition: color 0.3s;
            position: relative;
            padding-bottom: 4px;
        }
        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 1px;
            background: #C5A059;
            transform: scaleX(0);
            transform-origin: right center;
            transition: transform 0.3s ease;
        }
        .nav-links a:hover::after,
        .nav-links a.active::after {
            transform: scaleX(1);
            transform-origin: left center;
        }

        .nav-links a:hover, .nav-links a.active { color: #C5A059; }

        /* Dropdown */
.nav-item-dropdown {
    position: relative;
    display: inline-flex;
    align-items: center;
}
.nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: #1A3348;
    border: 1px solid rgba(197,160,89,0.2);
    border-radius: 8px;
    padding: 8px 0;
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s ease;
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    z-index: 1001;
}
.nav-item-dropdown:hover .nav-dropdown-menu,
.nav-item-dropdown:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(4px);
}
.nav-dropdown-menu a {
    display: block;
    padding: 10px 24px;
    font-size: 11px;
    color: #E0E6ED;
    text-decoration: none;
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 0.2s, color 0.2s;
}
.nav-dropdown-menu a:hover {
    background: rgba(197,160,89,0.1);
    color: #C5A059;
}
.nav-dropdown-menu a::after { display: none; }
.nav-dropdown-trigger {
    cursor: pointer;
}
.nav-dropdown-trigger::after {
    content: ' \25BE';
    font-size: 8px;
    opacity: 0.6;
}

        .nav-phone { font-family: 'Urbanist', sans-serif; font-size: 11px; letter-spacing: 1px; color: var(--accent-gold); text-decoration: none; padding: 6px 14px; border: 1px solid rgba(197,160,89,0.3); border-radius: 50px; transition: all 0.3s ease; white-space: nowrap; font-weight: 500; }
        .nav-phone:hover { background: var(--accent-gold); color: #1A3348; }

        .section-label {
            font-family: 'Urbanist', sans-serif;
            font-size: 10px;
            letter-spacing: 4px;
            color: #C5A059;
            text-transform: uppercase;
            display: block;
            margin-bottom: 16px;
        }
        .section-title {
            font-family: 'Urbanist', sans-serif;
            font-size: 32px;
            font-weight: 200;
            color: #1A1D24;
            letter-spacing: 3px;
            text-align: center;
        }

        .hero-section {
            padding: 70px 10% 28px;
            background: linear-gradient(135deg, #1A1D24 0%, #2A2D2A 50%, #1A1D24 100%);
            min-height: 55vh;
            display: flex;
            flex-direction: column;
        }
        .hero-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
            width: 100%;
        }
        .hero-tags {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
        }
        .hero-tag {
            font-family: 'Urbanist', sans-serif;
            font-size: 14px;
            color: rgba(255,255,255,0.65);
            letter-spacing: 1px;
        }
        .hero-tag .num {
            color: var(--accent-gold);
            font-weight: 500;
            transition: filter 0.3s ease;
        }
        .hero-tag .num:hover {
            filter: drop-shadow(0 0 8px rgba(197,160,89,0.4));
        }
        .hero-tag + .hero-tag::before {
            content: '/';
            color: rgba(255,255,255,0.12);
            margin-right: 16px;
        }

        .spec-table {
            width: 100%;
            max-width: 1000px;
            margin: 0 auto;
            border-collapse: collapse;
        }
        .spec-table th {
            font-family: 'Urbanist', sans-serif;
            font-size: 10px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--accent-gold);
            padding: 16px 20px;
            text-align: left;
            border-bottom: 2px solid var(--accent-gold);
            background: #FFFFFF;
        }
        .spec-table td {
            font-size: 14px;
            color: var(--text-secondary);
            padding: 16px 20px;
            border-bottom: 1px solid var(--border-color);
            line-height: 1.7;
            background: #FFFFFF;
        }
        .spec-table td:first-child {
            font-family: 'Urbanist', sans-serif;
            font-size: 12px;
            font-weight: 500;
            color: var(--text-primary);
            white-space: nowrap;
            width: 180px;
        }

        .hero-cat-links {
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            position: sticky;
            top: 70px;
            z-index: 50;
            margin-top: 24px;
            padding: 12px 0;
            flex-shrink: 0;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        .hero-cat-links::-webkit-scrollbar { display: none; }
        .hero-cat-links a {
            font-family: 'Urbanist', sans-serif;
            font-size: 10px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #D4AF37;
            text-decoration: none;
            padding: 10px 28px;
            background: transparent;
            border: 1px solid rgba(212,175,55,0.25);
            border-radius: 50px;
            transition: all 0.4s ease;
            position: relative;
            scroll-snap-align: start;
            flex-shrink: 0;
            white-space: nowrap;
        }
        .hero-cat-links a:hover {
            color: #D4AF37;
            border-color: rgba(212,175,55,0.6);
        }
        .hero-cat-links a.active {
            color: #D4AF37;
            background: #1A365D;
            border-color: #D4AF37;
        }
        .hero-cat-links a::after {
            content: attr(data-hint);
            position: absolute;
            bottom: -16px;
            left: 50%;
            transform: translateX(-50%) translateY(4px);
            font-family: 'Inter', sans-serif;
            font-size: 7px;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.25);
            white-space: nowrap;
            opacity: 0;
            transition: all 0.3s ease;
            pointer-events: none;
            font-weight: 300;
        }
        .hero-cat-links a:hover::after {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
        .cat-dot {
            display: none;
        }

        @media (max-width: 768px) {
            .hero-grid, .narrative-grid, .origin-grid, .product-grid { grid-template-columns: 1fr; gap: 40px; }
            .spec-table th, .spec-table td { padding: 12px; }
        }
        @media (max-width: 600px) {
            nav { padding: 0 5%; }
            .nav-links { gap: 12px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
            .nav-links a { font-size: 9px; letter-spacing: 0.5px; white-space: nowrap; }
            .hero-cat-links { justify-content: flex-start; gap: 6px; padding: 12px 10%; }
            .hero-cat-links a { font-size: 9px; letter-spacing: 1px; padding: 6px 12px; }
        }


